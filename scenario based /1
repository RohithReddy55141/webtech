                <form
                    class="registration-form"
                    action="#"
                    method="post"
                >


                    <!-- ROW 1 -->

                    <div class="form-row">

                        <div class="form-group">

                            <label for="studentName">
                                Student Name
                            </label>

                            <input
                                type="text"
                                id="studentName"
                                name="studentName"
                                placeholder="Enter your full name"
                                required
                            >

                        </div>


                        <div class="form-group">

                            <label for="registerNumber">
                                Register Number
                            </label>

                            <input
                                type="text"
                                id="registerNumber"
                                name="registerNumber"
                                placeholder="Enter register number"
                                required
                            >

                        </div>

                    </div>



                    <!-- ROW 2 -->

                    <div class="form-row">

                        <div class="form-group">

                            <label for="department">
                                Department
                            </label>

                            <select
                                id="department"
                                name="department"
                                required
                            >

                                <option value="">
                                    Select Department
                                </option>

                                <option value="IT">
                                    Information Technology
                                </option>

                                <option value="CSE">
                                    Computer Science Engineering
                                </option>

                                <option value="ECE">
                                    Electronics & Communication
                                </option>

                                <option value="EEE">
                                    Electrical & Electronics
                                </option>

                                <option value="MECH">
                                    Mechanical Engineering
                                </option>

                            </select>

                        </div>


                        <div class="form-group">

                            <label for="email">
                                Email Address
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="student@example.com"
                                required
                            >

                        </div>

                    </div>



                    <!-- EVENT -->

                    <div class="form-group">

                        <label for="event">
                            Select Event
                        </label>

                        <select
                            id="event"
                            name="event"
                            required
                        >

                            <option value="">
                                Choose an Event
                            </option>

                            <option>
                                ScrapeVerse Hackathon
                            </option>

                            <option>
                                SIMATS Cultural Fest
                            </option>

                            <option>
                                Inter College Sports Meet
                            </option>

                            <option>
                                Career & Placement Workshop
                            </option>

                        </select>

                    </div>



                    <!-- MESSAGE -->

                    <div class="form-group">

                        <label for="message">
                            Additional Message
                        </label>

                        <textarea
                            id="message"
                            name="message"
                            rows="4"
                            placeholder="Enter any additional information..."
                        ></textarea>

                    </div>



                    <!-- INLINE CSS -->

                    <p
                        style="
                        font-size:13px;
                        color:#627d98;
                        margin-bottom:15px;
                        "
                    >
